        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-24" parent="1" style="html=1;whiteSpace=wrap;" value="Vidí u Akcí, kde je jako zástup komplet vše o dané Akci,&lt;br&gt;ale nemůže nic měnit&lt;br&gt;&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt;Pokud někdo nemá roli zástup, nemůže ho nikdo přiřadit jako zástup k akci?&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="410" x="460" y="-780" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-25" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Organizátor" vertex="1">
          <mxGeometry height="60" width="30" x="380" y="-430" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-26" edge="1" parent="1" source="CH46KQ4xdru8luBsawXr-25" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" target="CH46KQ4xdru8luBsawXr-27" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="850" y="-330" as="sourcePoint" />
            <mxPoint x="510" y="-430" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-27" parent="1" style="html=1;whiteSpace=wrap;" value="Může vytvářet nové (své) Akce, měnit jejich nastavení a vyplněné údaje (kromě ekonomických).&lt;br&gt;Nemůže Akci/Událost smazat ze systému, ale může ji označit jako zrušenou." vertex="1">
