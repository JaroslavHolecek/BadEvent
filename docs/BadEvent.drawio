        <mxCell id="CH46KQ4xdru8luBsawXr-12" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Divák" vertex="1">
          <mxGeometry height="60" width="30" x="380" y="-930" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-13" edge="1" parent="1" source="CH46KQ4xdru8luBsawXr-12" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" target="CH46KQ4xdru8luBsawXr-14" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="850" y="-740" as="sourcePoint" />
            <mxPoint x="510" y="-840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-14" parent="1" style="html=1;whiteSpace=wrap;" value="Vidí kalendář budoucích Akcí&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt;- které? (jen závazně potvrzené, nebo i rozjednané, zrušené)&lt;/span&gt;&lt;br&gt;&lt;br&gt;a minulých Akci&lt;br&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt;- které? (jen proběhlé, nebo i zrušené)&lt;/span&gt;&lt;br&gt;&lt;br&gt;uvidí jen omezené množství informací &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt;- doplníme později které&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Vidí kalendář místností -&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt; v takovém přehledu se projeví pouze akce, které má oprávnění vidět, nebo nějak &quot;tajně&quot; i ty, které vidět nemůže?&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="410" x="460" y="-980" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-15" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Administrátor" vertex="1">
          <mxGeometry height="60" width="30" x="380" y="-590" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-16" edge="1" parent="1" source="CH46KQ4xdru8luBsawXr-15" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" target="CH46KQ4xdru8luBsawXr-17" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="850" y="-490" as="sourcePoint" />
            <mxPoint x="510" y="-590" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-17" parent="1" style="html=1;whiteSpace=wrap;" value="Vidí komplet vše a vše může měnit (ve smysluplných omezeních, např. nemůže nastavit datum konce před začátek a pod.)&lt;br&gt;&lt;br&gt;Jako jediný může:&lt;br&gt;- Smazat Akci/Událost ze systému (nezbydou po ní žádné stopy, kromě logů)&lt;div&gt;&lt;br&gt;&lt;/div&gt;- Měnit ostatním jejich Role&lt;br&gt;&lt;br&gt;- Vyplňovat u Akcí/Událostí &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 0));&quot;&gt;ekonomické údaje (které to jsou?)&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="410" x="460" y="-640" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-18" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="SuperUser" vertex="1">
          <mxGeometry height="60" width="30" x="910" y="-940" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-19" edge="1" parent="1" source="CH46KQ4xdru8luBsawXr-18" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" target="CH46KQ4xdru8luBsawXr-20" value="">
          <mxGeometry relative="1" width="160" as="geometry">
            <mxPoint x="1380" y="-840" as="sourcePoint" />
            <mxPoint x="1040" y="-940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-20" parent="1" style="html=1;whiteSpace=wrap;" value="Má přístup do databáze a ke zdrojovému kódu - může tedy dělat úplně cokoliv, i nesmyslné věci.&lt;br&gt;&lt;br&gt;Stojí &quot;mimo&quot; systém a není to konkrétní role - je to jednoduše ten, kdo má přístupové údaje k databázi a serveru" vertex="1">
          <mxGeometry height="120" width="410" x="990" y="-970" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-21" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Typ příjmu&lt;br&gt;(dotace, dar, vstupné, ...)&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ název: text&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;" vertex="1">
          <mxGeometry height="90" width="180" x="900" y="550" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-22" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" value="Zástup" vertex="1">
          <mxGeometry height="60" width="30" x="380" y="-750" as="geometry" />
        </mxCell>
        <mxCell id="CH46KQ4xdru8luBsawXr-23" edge="1" parent="1" source="CH46KQ4xdru8luBsawXr-22" style="endArrow=open;endFill=1;endSize=12;html=1;rounded=0;" target="CH46KQ4xdru8luBsawXr-24" value="">
          <mxGeometry relative="1" width="160" as="geometry">
